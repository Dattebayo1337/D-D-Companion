DATABASE_URL="file:./companion.db"
DATABASE_PROVIDER="sqlite"
# Internet deployment: set the exact HTTPS origin and a random secret (at least 32 characters).
# APP_ORIGIN="https://dnd.example.com"
# DND_HOST_KEY=""
# Without DND_HOST_KEY a local key is generated in .local/host-key.txt.

# Optional: close public registration while retaining existing account login.
# DND_REGISTRATION="closed"
