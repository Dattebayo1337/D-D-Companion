{
  "name": "dnd-companion",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "data:completeness:audit": "node --env-file=.env --import ./scripts/register.mjs scripts/audit-completeness.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import ./scripts/register.mjs --import ./scripts/test-setup.mjs --test --test-isolation=none src/tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:postgres:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:postgres:migrate": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "data:import": "node --env-file=.env --import ./scripts/register.mjs scripts/data.ts import",
    "data:validate": "node --env-file=.env --import ./scripts/register.mjs scripts/data.ts validate",
    "validate:ru": "node --env-file=.env --import ./scripts/register.mjs scripts/data.ts localization",
    "data:demo": "node --env-file=.env --import ./scripts/register.mjs scripts/data.ts import data/examples/homebrew.json",
    "format": "prettier --write .",
    "data:srd:build": "node --env-file=.env --import ./scripts/register.mjs scripts/build-srd.ts",
    "data:srd": "node --env-file=.env --import ./scripts/register.mjs scripts/import-srd.ts",
    "data:monsters:build": "node --env-file=.env --import ./scripts/register.mjs scripts/build-monsters.ts",
    "data:references:build": "node --env-file=.env --import ./scripts/register.mjs scripts/build-references.ts",
    "data:characters:build": "node --import ./scripts/register.mjs scripts/build-character-rules.ts",
    "data:backgrounds:build": "node --import ./scripts/register.mjs scripts/build-backgrounds.ts",
    "data:backgrounds": "node --env-file=.env --import ./scripts/register.mjs scripts/import-backgrounds.ts",
    "data:dndsu:build": "node --import ./scripts/register.mjs scripts/build-dndsu.ts",
    "data:dndsu": "node --env-file=.env --import ./scripts/register.mjs scripts/import-dndsu.ts",
    "data:subclasses:build": "node --import ./scripts/register.mjs scripts/build-subclasses.ts",
    "data:subclasses": "node --env-file=.env --import ./scripts/register.mjs scripts/import-subclasses.ts",
    "data:dndsu:audit": "node --env-file=.env --import ./scripts/register.mjs scripts/audit-dndsu.ts",
    "data:feats:build": "node --import ./scripts/register.mjs scripts/build-feats.ts",
    "data:feats": "node --env-file=.env --import ./scripts/register.mjs scripts/import-feats.ts",
    "data:options:build": "node --import ./scripts/register.mjs scripts/build-options.ts",
    "data:options": "node --env-file=.env --import ./scripts/register.mjs scripts/import-options.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@tailwindcss/postcss": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.4",
    "snowball-stemmers": "^0.6.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
